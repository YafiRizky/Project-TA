## 🔐 Login Logic (with Code Validation)

### **Login Flow:**

```python
def login(request):
    business_code = request.POST.get('business_code')  # XY89PQ
    username = request.POST.get('username')            # kasir1
    password = request.POST.get('password')
    
    # Step 1: Find business code
    code_obj = BusinessCode.objects.filter(
        code=business_code
    ).first()
    
    if not code_obj:
        return error("Business code tidak valid")
    
    # Step 2: Check code status
    now = timezone.now()
    
    if code_obj.status == 'expired':
        return error("Business code sudah tidak aktif. Hubungi admin untuk code terbaru.")
    
    if code_obj.status == 'grace_period':
        # Code lama masih valid tapi kasih warning
        if code_obj.valid_until and now > code_obj.valid_until:
            code_obj.status = 'expired'
            code_obj.save()
            return error("Business code sudah expired. Gunakan code terbaru.")
        else:
            warning_message = f"⚠️ Code ini akan expired pada {code_obj.valid_until}. Gunakan code baru secepatnya."
    
    if code_obj.status != 'active' and code_obj.status != 'grace_period':
        return error("Business code tidak valid")
    
    # Step 3: Get user
    user = User.objects.filter(
        business_id=code_obj.business_id,
        username=username
    ).first()
    
    if not user or not user.check_password(password):
        return error("Username atau password salah")
    
    # Step 4: Login success
    login_user(user)
    
    if code_obj.status == 'grace_period':
        show_warning(warning_message)
    
    return redirect('dashboard')
```

