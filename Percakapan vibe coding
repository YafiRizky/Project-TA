## 🔄 Generate New Code Function

```python
def generate_new_business_code(request):
    # Only admin can do this
    if request.user.role != 'admin':
        return error("Unauthorized")
    
    business = request.user.business
    grace_period_days = int(request.POST.get('grace_period', 7))
    
    # Step 1: Generate new code (random 6 alphanumeric, uppercase)
    import random, string
    while True:
        new_code = ''.join(random.choices(string.ascii_uppercase + string.digits, k=6))
        # Check not exists
        if not BusinessCode.objects.filter(code=new_code).exists():
            break
    
    # Step 2: Set old code to grace_period
    old_code = business.current_code
    if old_code:
        old_code.status = 'grace_period'
        old_code.valid_until = timezone.now() + timedelta(days=grace_period_days)
        old_code.save()
    
    # Step 3: Create new code
    new_code_obj = BusinessCode.objects.create(
        business=business,
        code=new_code,
        status='active',
        valid_from=timezone.now(),
        valid_until=None,  # No expiry
        created_by=request.user
    )
    
    # Step 4: Update business current_code
    business.current_code = new_code_obj
    business.save()
    
    # Step 5: Log audit
    AuditLog.objects.create(
        business=business,
        user=request.user,
        action='business_code_rotated',
        old_value=old_code.code if old_code else None,
        new_value=new_code,
        timestamp=timezone.now()
    )
    
    # Step 6: Notify kasir (optional: send email/SMS)
    kasir_users = User.objects.filter(business=business, role='kasir')
    for kasir in kasir_users:
        # Send notification (email/SMS/push)
        send_notification(
            kasir,
            title="Business Code Diperbarui",
            message=f"Code baru: {new_code}. Code lama valid sampai {old_code.valid_until}."
        )
    
    return JsonResponse({
        'success': True,
        'old_code': old_code.code if old_code else None,
        'new_code': new_code,
        'grace_period_until': old_code.valid_until if old_code else None
    })
```

