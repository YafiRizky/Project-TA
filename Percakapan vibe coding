# Generate Barcode Logic
def generate_barcode(product_code, date):
    date_str = date.strftime('%d%m%y')  # 050326
    
    # Cek sequence hari ini
    last_batch = ProductBatch.objects.filter(
        product__code=product_code,
        created_at__date=date
    ).order_by('-barcode').first()
    
    if last_batch:
        seq = int(last_batch.barcode[-3:]) + 1  # 001 → 002
    else:
        seq = 1
    
    barcode = f"{product_code}{date_str}{seq:03d}"  # 02050326001
    return barcode

# Saat save batch
