  kode_katalog (2 digit: 01, 02, 03...) -- UNIQUE per produk
  kategori_id, supplier_id_default
  harga_jual, harga_beli (weighted avg)
  min_stok, foto, status

-- STOK SUMMARY
Stock
  product_id, jumlah (sum dari semua batch active)

-- BATCH DETAIL (INI YANG PENTING!)
ProductBatch
  id
  product_id (FK ke Product katalog)
  batch_code (BATCH-YYYYMMDD-XXX)
  batch_barcode (11 digit: KODEDDMMYYXXX) -- UNIQUE, printable
  jumlah (qty batch ini)
  harga_beli (per batch)
  expired_date (optional, per batch)
  tanggal_masuk
  status (active/depleted/expired)

-- HISTORY
StockMovement
  product_id, batch_id
  tipe (IN/OUT/SALE/EXPIRED)
  jumlah, saldo_akhir, tanggal, keterangan

-- TRANSAKSI
Sale, SaleItem

-- MASTER
Category, Supplier, User
EmailVerification, PasswordReset
