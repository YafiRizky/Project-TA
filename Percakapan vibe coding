### **📧 EMAIL IMPLEMENTATION PLAN:**

```python
# users/utils.py

from django.core.mail import send_mail
from django.conf import settings
import random
import string

def generate_verification_code():
    """Generate 6 digit verification code"""
    return ''.join(random.choices(string.digits, k=6))

def send_verification_email(user_email, verification_code):
    """
    Send verification email
    - DEVELOPMENT: Print to console atau MailHog
    - PRODUCTION: Real email via SendGrid/AWS SES
    """
    subject = 'POS System - Verify Your Email'
    message = f'''
    Hi,
    
    Your verification code: {verification_code}
    
    Or click this link:
    {settings.FRONTEND_URL}/verify?email={user_email}&code={verification_code}
    
    Valid for 10 minutes.
    
    Regards,
    POS Team
    '''
    
    send_mail(
        subject=subject,
        message=message,
        from_email=settings.DEFAULT_FROM_EMAIL,
        recipient_list=[user_email],
        fail_silently=False,
    )
```

