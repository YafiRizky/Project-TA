```python
# Custom authentication class untuk check blacklist
from rest_framework_simplejwt.authentication import JWTAuthentication

class CustomJWTAuthentication(JWTAuthentication):
    def authenticate(self, request):
        # Panggil authentication standard
        validated = super().authenticate(request)
        
        if validated is None:
            return None
        
        user, token = validated
        
        # Check blacklist manual
        jti = token.get('jti')
        if TokenBlacklist.objects.filter(jti=jti).exists():
            raise AuthenticationFailed('Token has been blacklisted')
        
        return user, token
```

