**Best Practice: Solusi 1 + 2 (Check + DB Constraint)**

```python
import random
import string
from django.db import IntegrityError

def generate_unique_business_code(max_retries=10):
    """
    Generate unique 6-character business code.
    Format: [A-Z0-9]{6}
    Total combinations: 36^6 = 2,176,782,336
    """
    for attempt in range(max_retries):
        # Generate random code
        code = ''.join(random.choices(
            string.ascii_uppercase + string.digits,
            k=6
        ))
        
        # Check if exists
        if not Business.objects.filter(business_code=code).exists():
            return code
    
    # If max retries reached (VERY unlikely)
    raise ValueError(
        "Gagal generate unique code setelah {} percobaan. "
        "Ini sangat jarang terjadi. Silakan coba lagi.".format(max_retries)
    )

# Usage in view
def generate_new_code(request):
    business = request.user.business
    old_code = business.business_code
    
    try:
        # Generate unique code
        new_code = generate_unique_business_code()
        
        # Save to database (with UNIQUE constraint protection)
        business.business_code = new_code
        business.save()
        
        # Log history
        BusinessCodeHistory.objects.create(
            business=business,
            old_code=old_code,
            new_code=new_code,
            changed_by=request.user
        )
        
        return JsonResponse({
            'success': True,
            'new_code': new_code
        })
        
    except IntegrityError:
        # Database detected duplicate (safety net)
        # This should NEVER happen due to check above, but just in case
        return JsonResponse({
            'success': False,
            'error': 'Collision terdeteksi. Silakan coba lagi.'
        }, status=500)
```

