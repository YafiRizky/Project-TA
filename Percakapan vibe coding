# Check batch expiry vs velocity
batches = ProductBatch.objects.filter(status='active')

risky_batches = []
for batch in batches:
    days_to_expiry = (batch.expired_date - date.today()).days
    avg_sales = df[df['product_id']==batch.product_id]['qty'].mean()
    
    if avg_sales > 0:
