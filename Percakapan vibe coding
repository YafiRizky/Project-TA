import joblib
import pandas as pd

class StockoutPredictionView(APIView):
    def get(self, request):
        business = request.user.business
        
        # Load model
        model = joblib.load('models/stockout_model.pkl')
        
        # Get current stock data
        products = Product.objects.filter(business=business)
        predictions = []
        
        for product in products:
            # Calculate features
            sales_avg = SaleItem.objects.filter(
                product=product,
                sale__created_at__gte=date.today() - timedelta(days=30)
            ).aggregate(Avg('qty'))['qty__avg'] or 0
            
            current_stock = product.get_total_stock()
            
            if sales_avg > 0:
                X = pd.DataFrame([[current_stock, sales_avg, sales_avg * 0.2]])
                risk_prob = model.predict_proba(X)[0][1]  # Probability class 1 (risky)
                
                if risk_prob > 0.7:  # Threshold 70%
                    predictions.append({
                        'product_id': product.id,
                        'product_name': product.name,
                        'current_stock': current_stock,
                        'avg_sales': sales_avg,
                        'risk_score': risk_prob,
                        'days_until_stockout': int(current_stock / sales_avg),
                        'recommended_restock': int(sales_avg * 14)  # 2 weeks supply
                    })
        
        return Response({
            'predictions': sorted(predictions, key=lambda x: x['risk_score'], reverse=True)
        })
