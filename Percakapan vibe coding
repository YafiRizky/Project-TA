# ml/model_trainer.py
from sklearn.ensemble import RandomForestRegressor
import pandas as pd
import joblib

def train_stock_forecast_model():
    # 1. Ambil data dari database
    data = get_sales_history()  # 90 hari terakhir
    
    # 2. Feature engineering
    df = pd.DataFrame(data)
    df['avg_sales_7d'] = df.groupby('product_id')['qty_sold'].rolling(7).mean()
    df['day_of_week'] = pd.to_datetime(df['date']).dt.dayofweek
    
    # 3. Split X dan y
    X = df[['avg_sales_7d', 'day_of_week', 'stock_level', 'waste_rate']]
    y = df['qty_sold']  # Target: jumlah terjual
    
    # 4. Training
    model = RandomForestRegressor(n_estimators=100)
    model.fit(X, y)
    
    # 5. Save model
    joblib.dump(model, 'ml/models/stock_forecast_rf.pkl')
    
    return model

# ml/predictor.py
def predict_stock_needed(product_id, days_ahead=7):
    # 1. Load model
    model = joblib.load('ml/models/stock_forecast_rf.pkl')
    
    # 2. Prepare input data
    recent_data = get_product_recent_data(product_id)
    X_predict = prepare_features(recent_data)
    
    # 3. Predict
    predicted_daily_sales = model.predict(X_predict)
    total_needed = predicted_daily_sales.sum() * days_ahead
    
    # 4. Simpan ke database
    MLPrediction.objects.create(
        business=business,
        product_id=product_id,
        prediction_type='stock_forecast',
        prediction_value={'qty_needed': total_needed},
        confidence_score=0.85,
        valid_until=timezone.now() + timedelta(days=7)
    )
    
    return total_needed
```

