### **OPSI 2: Custom Blacklist Table** ⭐⭐⭐⭐

**Middle ground: Keep custom User model, implement manual blacklist**

```python
# users/models.py (tetap seperti sekarang)
class User(models.Model):
    # ... tidak berubah

# Tambah model baru untuk blacklist
class TokenBlacklist(models.Model):
    """Manual token blacklist for custom User model"""
    jti = models.CharField(max_length=255, unique=True, db_index=True)
    user = models.ForeignKey(User, on_delete=models.CASCADE)
    token = models.TextField()
    blacklisted_at = models.DateTimeField(auto_now_add=True)
    expires_at = models.DateTimeField()
    
    class Meta:
        db_table = 'token_blacklist'
        indexes = [
            models.Index(fields=['jti']),
            models.Index(fields=['expires_at']),
        ]
    
    def __str__(self):
        return f"Blacklisted: {self.jti}"

# Cleanup expired tokens (cron job)
@staticmethod
def cleanup_expired():
    TokenBlacklist.objects.filter(expires_at__lt=timezone.now()).delete()
