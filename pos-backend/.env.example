# ===========================================
# POS ML Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in production values
# For development, defaults are already set in settings.py

# Django
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database (PostgreSQL)
DB_NAME=pos_ml
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
